filters:
  and:
    - 'file.ext == "md"'
properties:
  file.name:
    displayName: Entrada
  space:
    displayName: Espacio
  area:
    displayName: Área
  kind:
    displayName: Tipo
  project:
    displayName: Proyecto
  file.tags:
    displayName: Tags
  publish:
    displayName: Publicada
views:
  - type: table
    name: Inventario
    groupBy:
      property: space
      direction: ASC
    order:
      - file.name
      - space
      - area
      - kind
      - project
      - file.tags
      - publish
